# ── extrain_shop monorepo ──
# Each app keeps its own .gitignore too; this file covers the repo root and
# anything that must never reach the repository.

# Dependencies & build output (any depth)
node_modules/
.next/
dist/
*.tsbuildinfo

# Secrets — only the .env.example templates are committed
.env
.env.*
!.env.example

# Local tooling
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Working material kept out of the repo (screenshots, mockups, reports)
/*.png
/*.jpg
/*.jpeg
/*.pdf

# Local development database (scripts/dev-db.mjs)
.devdb/
